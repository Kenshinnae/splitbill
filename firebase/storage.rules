rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Receipt images live under bills/{billId}/...
    // MVP: any signed-in user can upload — the app only calls this from the owner flow.
    // Tighten later: validate path matches a Firestore bill owned by request.auth.uid (via Cloud Function or custom metadata).

    match /bills/{billId}/{fileName=**} {
      allow read: if true;
      // TODO: restrict read to participants / owner once you add Firebase Auth custom tokens for guests or signed URLs.
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
